# Copy to .env on the shop PC. The installer does this for you if .env is missing.

# sandbox = AJK test endpoint, production = live filing.
# Must match the build of the fiscal component installed on this machine.
FBR_ENV=production

# The ERP's built JavaScript hardcodes localhost:4000. Changing this means
# rebuilding and redeploying the client, so leave it alone.
PORT=4000

# ── This machine's POS identity ───────────────────────────────────────────────
# Must match the POS ID this PC is registered under on the IRIS-AJK portal. It is
# sent as POSID on every invoice, so a wrong value here files real invoices against
# somebody else's registration.
FBR_POS_ID=822091

# The production token AJK issue at POS registration, found under the POS Clients
# menu on the IRIS-AJK portal.
#
# This is NOT the Access Code. The Access Code is typed into the fiscal component's
# installer once, and is never sent to the API — do not paste it here.
#
# Only the cloud endpoint uses this — the local component on port 8524 authenticates
# from its own installation. With FBR_POS_ID set and this left blank, cloud filing is
# refused rather than falling back to another shop's token.
FBR_PRODUCTION_TOKEN=

# ── Auto-filing of invoices raised while this PC was off ──────────────────────
# The ERP is hosted, so staff can raise an invoice from any machine at any time.
# Those land in the database as fbr_status 'pending'. The agent files them on its
# own — once shortly after it starts, then on the interval below.
#
# This is the publishable (anon) key, the same one the ERP website itself uses.
# It is not a secret and grants nothing the browser does not already have.
SUPABASE_URL=https://jipbwqaneafuzgoywxun.supabase.co
SUPABASE_KEY=sb_publishable_OAN7BB4vExlA7_y4nfXReg_pJZT1Kl2

# Set false to turn auto-filing off and go back to pressing Submit by hand.
QUEUE_ENABLED=true

# How often to look for waiting invoices.
QUEUE_INTERVAL_MINUTES=5

# Give up on an invoice after this many failed attempts, so one bad invoice
# cannot be retried forever. It stays visible as 'failed' on the FBR screen.
QUEUE_MAX_RETRIES=5

# Most invoices to file in one pass.
QUEUE_BATCH_LIMIT=50

# Both this agent and the AJK fiscal component start with Windows, and the
# component is the slower of the two. Wait before the first pass rather than
# burning a retry on every backlogged invoice at 8am.
QUEUE_STARTUP_DELAY_SECONDS=45

# true  = only file through the local AJK fiscal component; if it is not answering,
#         leave the backlog and try again next pass.
# false = fall back to the AJK cloud endpoint when the component is down.
# Left true because AJK register a POS against one till machine and the local
# component is the path they nominate.
QUEUE_REQUIRE_LOCAL=true
